from magika.types.content_type_info import ContentTypeInfo as ContentTypeInfo
from magika.types.magika_prediction import MagikaPrediction as MagikaPrediction
from magika.types.status import Status as Status
from pathlib import Path

class MagikaResult:
    def __init__(self, *, path: Path, status: Status = ..., prediction: MagikaPrediction | None = None) -> None: ...
    def __post_init__(self) -> None: ...
    @property
    def path(self) -> Path: ...
    @property
    def ok(self) -> bool: ...
    @property
    def status(self) -> Status: ...
    @property
    def prediction(self) -> MagikaPrediction: ...
    @property
    def dl(self) -> ContentTypeInfo: ...
    @property
    def output(self) -> ContentTypeInfo: ...
    @property
    def score(self) -> float: ...
