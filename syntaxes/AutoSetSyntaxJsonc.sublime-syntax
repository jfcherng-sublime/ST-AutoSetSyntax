%YAML 1.2
---
# This is just a scope-modified version of the JSON syntax from the `Default` package.
# Because I don't want LSP-json to be applied on generated JSON views.

name: AutoSetSyntax JSONC
scope: source.autosetsyntax.jsonc
version: 2
hidden: true

contexts:

  prototype:
    - include: comments

  main:
    - include: values

  values:
    - include: constants
    - include: floats
    - include: integers
    - include: strings
    - include: arrays
    - include: objects

###[ COMMENTS ]################################################################

  comments:
    - include: block-comments
    - include: line-comments

  block-comments:
    # empty block comments
    - match: /\*\*+/
      scope: comment.block.empty.jsonc punctuation.definition.comment.jsonc
    # documentation block comments
    - match: /\*\*+
      scope: punctuation.definition.comment.begin.jsonc
      push: block-comment-documentation-body
    # normal block comments
    - match: /\*
      scope: punctuation.definition.comment.begin.jsonc
      push: block-comment-body

  block-comment-documentation-body:
    - meta_include_prototype: false
    - meta_scope: comment.block.documentation.jsonc
    - match: \*+/
      scope: punctuation.definition.comment.end.jsonc
      pop: 1
    - match: ^\s*(\*)(?![*/])
      captures:
        1: punctuation.definition.comment.jsonc

  block-comment-body:
    - meta_include_prototype: false
    - meta_scope: comment.block.jsonc
    - match: \*/
      scope: punctuation.definition.comment.end.jsonc
      pop: 1
    - match: ^\s*(\*)(?![*/])
      captures:
        1: punctuation.definition.comment.jsonc

  line-comments:
    - match: //
      scope: punctuation.definition.comment.jsonc
      push: line-comment-body

  line-comment-body:
    - meta_include_prototype: false
    - meta_scope: comment.line.double-slash.jsonc
    - match: $\n?
      pop: 1

###[ ARRAYS ]##################################################################

  arrays:
    - match: \[
      scope: punctuation.section.sequence.begin.jsonc
      push: array-body

  array-body:
    - meta_scope: meta.sequence.jsonc
    - match: \]
      scope: punctuation.section.sequence.end.jsonc
      pop: 1
    - match: ','
      scope: punctuation.separator.sequence.jsonc
    - include: values
    - match: \S
      scope: invalid.illegal.expected-sequence-separator.jsonc

###[ OBJECTS ]#################################################################

  objects:
    - match: \{
      scope: punctuation.section.mapping.begin.jsonc
      push: object-body

  object-body:
    - meta_scope: meta.mapping.jsonc
    - match: \}
      scope: punctuation.section.mapping.end.jsonc
      pop: 1
    - match: \"
      scope: punctuation.definition.string.begin.jsonc
      push: object-key-body
    - match: ':'
      scope: punctuation.separator.key-value.jsonc
      push: expect-object-value
    - match: \S
      scope: invalid.illegal.expected-mapping-key.jsonc

  object-key-body:
    - clear_scopes: 1
    - meta_include_prototype: false
    - meta_scope: meta.mapping.key.jsonc string.quoted.double.jsonc
    - include: double-quoted-string-body

  expect-object-value:
    - meta_include_prototype: false
    - include: comments
    - match: ',|\s?(?=\})'
      scope: invalid.illegal.expected-mapping-value.jsonc
      pop: 1
    - match: (?=\S)
      set: object-value-body

  object-value-body:
    - clear_scopes: 1
    - meta_scope: meta.mapping.value.jsonc
    - include: values
    - match: ''
      set: object-value-end

  object-value-end:
    - meta_include_prototype: false
    - include: comments
    - match: (?=\s*\})
      pop: 1
    - match: ','
      scope: punctuation.separator.sequence.jsonc
      pop: 1
    - match: \s(?!/[/*])(?=[^\s,])|[^\s,]
      scope: invalid.illegal.expected-mapping-separator.jsonc
      pop: 1

###[ LITERALS ]################################################################

  constants:
    - match: \bfalse\b
      scope: constant.language.boolean.false.jsonc
    - match: \btrue\b
      scope: constant.language.boolean.true.jsonc
    - match: \bnull\b
      scope: constant.language.null.jsonc

  floats:
    - match: (-?)((?:0|[1-9]\d*)(?:(?:(\.)\d+)(?:[eE][-+]?\d+)?|(?:[eE][-+]?\d+)))
      scope: meta.number.float.decimal.jsonc
      captures:
        1: keyword.operator.arithmetic.jsonc
        2: constant.numeric.value.jsonc
        3: punctuation.separator.decimal.jsonc

  integers:
    - match: (-?)(0|[1-9]\d*)
      scope: meta.number.integer.decimal.jsonc
      captures:
        1: keyword.operator.arithmetic.jsonc
        2: constant.numeric.value.jsonc

  strings:
    - match: \"
      scope: punctuation.definition.string.begin.jsonc
      push: double-quoted-string-body

  double-quoted-string-body:
    - meta_include_prototype: false
    - meta_scope: meta.string.jsonc string.quoted.double.jsonc
    - match: \"
      scope: punctuation.definition.string.end.jsonc
      pop: 1
    - match: \n
      scope: invalid.illegal.unclosed-string.jsonc
      pop: 1
    - include: string-prototype
    - include: string-escapes

  # for use by inheriting syntaxes to easily inject string interpolation
  # in any kind of quoted or unquoted string
  string-prototype: []

  string-escapes:
    - match: |-
        (?x:                # turn on extended mode
          \\                # a literal backslash
          (?:               # ...followed by...
            ["\\/bfnrt]     # one of these characters
            |               # ...or...
            u               # a u
            [0-9a-fA-F]{4}  # and four hex digits
          )
        )
      scope: constant.character.escape.jsonc
    - match: \\.
      scope: invalid.illegal.unrecognized-string-escape.jsonc
